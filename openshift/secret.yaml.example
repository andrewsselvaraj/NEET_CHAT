# Template only: never commit a real key. `oc apply -f openshift/` skips this file.
# Create the real secret once per project, e.g.:
#   oc create secret generic neet-chat-secrets --from-literal=NEET_LLM_API_KEY=<key>
apiVersion: v1
kind: Secret
metadata:
  name: neet-chat-secrets
  labels:
    app: neet-chat
type: Opaque
stringData:
  NEET_LLM_API_KEY: <your-openai-api-key>
